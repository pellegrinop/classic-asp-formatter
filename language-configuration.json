{
    "comments": {
        "lineComment": "'"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "<%", "close": "%>" }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["<%", "%>"]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*<%\\s*(If|For|While|Do|Select Case|Function|Sub)",
            "end": "^\\s*(End If|Next|Wend|Loop|End Select|End Function|End Sub)\\s*%>"
        }
    }
}
